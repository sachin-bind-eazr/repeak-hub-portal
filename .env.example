# Repeak Hub Portal — environment reference (committed; `.env.*` is
# gitignored except this file). Copy to `.env.production` for a live
# build, or `.env.local` for host-side dev.
#
# All four vars are NEXT_PUBLIC_* → inlined by Next at BUILD time.
# Changing one requires a rebuild + redeploy. No trailing slashes:
# the code concatenates directly (`${API_BASE}${path}`,
# `${DEST_BASE_URL[p]}/activate?…`).
#
# Every var has a live-production fallback baked into the source
# (lib/api.ts:27, lib/activation.ts:12-14), so an unset var resolves to
# production rather than localhost.

# Backend base URL — browser calls it directly, cross-origin.
# Source default: https://repeak-backend-746271877146.asia-south1.run.app

# Destination portals for the /activate handoff. Must be browser-reachable.
# Source defaults: partner.repeak.in / brand.repeak.in / club.repeak.in
# ── Local dev against the docker stack ────────────────────────────────
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_OM_BASE_URL=http://localhost:4004
# NEXT_PUBLIC_BM_BASE_URL=http://localhost:3399
# NEXT_PUBLIC_CM_BASE_URL=http://localhost:4005


NEXT_PUBLIC_API_BASE_URL=https://repeak-backend-746271877146.asia-south1.run.app
NEXT_PUBLIC_OM_BASE_URL=https://partner.repeak.in
NEXT_PUBLIC_BM_BASE_URL=https://brand.repeak.in
NEXT_PUBLIC_CM_BASE_URL=https://club.repeak.in